# Тяжёлые/сгенерированные папки, которые не нужно индексировать Claude Code.
# Аналог .gitignore, но для контекста ассистента — здесь может быть шире.

# VCS
.git/

# Node / frontend
node_modules/
dist/
dist-ssr/
.vite/

# Go / backend
apps/backend/bin/
apps/backend/tmp/

# Docker / данные БД (если когда-либо примонтированы локально)
mysql_data/

# Логи
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Редакторы / ОС
.idea/
.vscode/
.DS_Store
Thumbs.db
