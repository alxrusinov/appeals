# ==========================================
# ЭТАП 1: Сборка статических файлов (React + Vite)
# ==========================================
FROM node:24-alpine AS builder

WORKDIR /app

# Копируем файлы конфигурации пакетов для кэширования слоев
COPY package*.json ./

# Устанавливаем зависимости (npm ci быстрее и строже для CI/CD, чем npm install)
RUN npm ci

# Копируем весь исходный код фронтенда
COPY . .

# Собираем production-версию проекта (на выходе получаем папку dist)
RUN npm run build

# ==========================================
# ЭТАП 2: Раздача статики через высокопроизводительный Nginx
# ==========================================
FROM nginx:1.27-alpine AS runner

# Копируем скомпилированную статику из этапа сборщика в дефолтную папку Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Копируем наш кастомный конфиг для корректной работы SPA-роутинга
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Фронтенд будет слушать стандартный HTTP-порт
EXPOSE 80

# Запуск Nginx на переднем плане (обязательно для Docker)
CMD ["nginx", "-g", "daemon off;"]
